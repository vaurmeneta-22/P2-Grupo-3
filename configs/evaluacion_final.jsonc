  ],
  "pesos_curva_clima_independientes": true, // Hipótesis nominal: mezcla de hidratación independiente del clima; hacer sensibilidad.
  "escenarios_conjuntos": [
    // Alternativa a independencia: listar combinaciones curva/clima y pesos conjuntos que sumen 1.
